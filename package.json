{
  "name": "moolam",
  "private": true,
  "version": "0.1.0",
  "description": "Moolam: a passport for every AI-generated image, registered on Monad the moment it is made and verifiable from any re-encoded copy.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "spike:verifier": "npm run spike --workspace packages/verifier",
    "test:verifier": "npm run test --workspace packages/verifier",
    "robustness": "npm run robustness --workspace packages/verifier",
    "dev:verifier": "npm run dev --workspace packages/verifier",
    "codegen:indexer": "npm run codegen --workspace packages/indexer",
    "test:indexer": "npm run test --workspace packages/indexer",
    "test:agents": "npm run test --workspace packages/agents",
    "proof:anvil": "npm run proof --workspace packages/agents",
    "seed": "npm run seed --workspace packages/agents",
    "prove:privy": "npm run prove:privy --workspace packages/agents"
  },
  "allowScripts": {
    "@contentauth/c2pa-node@0.9.3": true,
    "esbuild@0.27.2": true
  }
}
