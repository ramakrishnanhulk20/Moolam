# The Moolam web app. Copy to .env.local and fill in. .env.local is never committed.
# Only NEXT_PUBLIC_ values reach the browser, so nothing secret may carry that prefix.

# Privy app id from dashboard.privy.io. Same value as PRIVY_APP_ID in the repo root .env.
# Without it every page still works and the studio says Privy is not configured.
NEXT_PUBLIC_PRIVY_APP_ID=

# Monad mainnet RPC. The default below is Alchemy's public Monad endpoint, which
# allows a wide eth_getLogs range; https://rpc.monad.xyz caps it at 100 blocks and
# the latest-passports strip then falls back to a slow backwards scan.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc1.monad.xyz

# Optional, secret, and read on the server only: a dedicated Monad endpoint, such as a QuickNode
# one, whose address carries its own access token. Set it and every read the server makes tries
# this endpoint first and the public one above only when it fails. Leave it empty and the public
# endpoint answers everything, as before. It must be an https URL or the app refuses to start, and
# it must never be given a NEXT_PUBLIC name: that would publish the token to every browser.
MONAD_RPC_URL=

# Envio Cloud GraphQL endpoint. Set it and the app reads passports from the index
# instead of scanning the chain. The footer says which one answered. This is the public, read-only
# index the live site reads; scanning the chain instead makes the first page load take minutes.
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=https://indexer.dev.hyperindex.xyz/c7ac4e0/v1/graphql
# Set it to 1 for one production build when the index is down and the build must still ship. The
# build then logs the failed read and goes ahead without the index, where otherwise it stops. Leave
# it unset on every normal build.
MOOLAM_BUILD_WITHOUT_INDEX=

# The verifier service as the browser reaches it. The studio posts uploads to
# /prepare and /verify on this origin, so it has to be a URL a browser can open,
# not an internal address. Its CORS_ORIGINS must list this app's origin.
NEXT_PUBLIC_VERIFIER_URL=http://localhost:4010

# The IPFS gateway every stored ipfs:// URI is read through. The shared
# gateway.pinata.cloud below works but rate limits hard on a page full of
# thumbnails; a dedicated Pinata gateway (the PINATA_GATEWAY_URL in the repo
# root .env) is what production should use. Keep the trailing slash.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Set it to 1 on your own dev server only: draft docs pages are shown, and your
# visits are not counted by the analytics. Leave it unset everywhere else. The
# deployment does not set it.
NEXT_PUBLIC_LAB_PAGES=

# Where this app answers in public. It is the base for every social card picture
# and for the sitemap, so a link pasted into a chat names this domain rather than
# whichever deployment URL served the crawler. Defaults to https://moolam.site.
NEXT_PUBLIC_SITE_URL=

# The two public Privy ids behind the edit panel on a passport page. The signer id
# is the key quorum whose member is the app's authorization key, the one the hosted
# /edit route signs with. The policy id is the rule Privy holds that key to, which
# allows appendEdit on the registry and nothing else. Both are ids, not keys, so
# they are safe in the browser. Leave either one empty and the panel says the owner
# cannot add an edit from here yet.
NEXT_PUBLIC_PRIVY_SIGNER_ID=
NEXT_PUBLIC_PRIVY_EDIT_POLICY_ID=
