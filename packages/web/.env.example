# The Moolam web app. Copy to .env.local and fill in. .env.local is never committed.
# Only NEXT_PUBLIC_ values reach the browser, so nothing secret may carry that prefix.

# Privy app id from dashboard.privy.io. Same value as PRIVY_APP_ID in the repo root .env.
# Without it every page still works and the studio says Privy is not configured.
NEXT_PUBLIC_PRIVY_APP_ID=

# Monad mainnet RPC. The default below is Alchemy's public Monad endpoint, which
# allows a wide eth_getLogs range; https://rpc.monad.xyz caps it at 100 blocks and
# the latest-passports strip then falls back to a slow backwards scan.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc1.monad.xyz

# Envio Cloud GraphQL endpoint. Set it and the app reads passports from the index
# instead of scanning the chain. The footer says which one answered.
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=


# The verifier service as the browser reaches it. The studio posts uploads to
# /prepare and /verify on this origin, so it has to be a URL a browser can open,
# not an internal address. Its CORS_ORIGINS must list this app's origin.
NEXT_PUBLIC_VERIFIER_URL=http://localhost:4010

# The IPFS gateway every stored ipfs:// URI is read through. The shared
# gateway.pinata.cloud below works but rate limits hard on a page full of
# thumbnails; a dedicated Pinata gateway (the PINATA_GATEWAY_URL in the repo
# root .env) is what production should use. Keep the trailing slash.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# The hidden bench at /lab and /lab/logo. Set it to 1 on a machine where you are
# building something visual; leave it unset everywhere else and both routes are a
# 404. The deployment does not set it.
NEXT_PUBLIC_LAB_PAGES=

# Where this app answers in public. It is the base for every social card picture
# and for the sitemap, so a link pasted into a chat names this domain rather than
# whichever deployment URL served the crawler. Defaults to https://moolam.vercel.app.
NEXT_PUBLIC_SITE_URL=
