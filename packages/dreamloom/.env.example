# The Moolam verify service Dreamloom prepares and signs pictures through.
MOOLAM_VERIFY_URL=
# The Moolam site that hosts the co-sign and connect pages and the passport pages.
MOOLAM_SITE_URL=
# A Monad mainnet RPC endpoint for reads and for Dreamloom's own transactions.
MONAD_RPC_URL=
# Dreamloom's own origin, exactly as a browser sends it (https://host, no path). Every POST's Origin header must equal it. Left empty outside production it is http://localhost:3300.
DREAMLOOM_ORIGIN=
# Dreamloom's ERC-8004 agent id, printed by the setup script.
DREAMLOOM_AGENT_ID=
# The private key of Dreamloom's wallet (agent owner and creator wallet). Server only, never printed.
DREAMLOOM_WALLET_KEY=
# The private key of Dreamloom's software passkey from setupPlatform. Server only, never printed.
DREAMLOOM_PASSKEY_KEY=
# The hostname the software passkey is bound to, Dreamloom's own domain.
DREAMLOOM_PASSKEY_RP_ID=
# The platform key Moolam issued to Dreamloom, sent to the verify service only.
DREAMLOOM_PLATFORM_KEY=
# The OpenAI key that draws the pictures.
OPENAI_API_KEY=
# Moolam's index, read for the gallery of pictures Dreamloom registered.
MOOLAM_INDEX_URL=
# The folder for sessions, pictures, pending co-signs and counters (a Railway volume when deployed).
DATA_DIR=
# How many pictures one visitor address may weave a day. 0 closes weaving.
WEAVES_PER_ADDRESS_PER_DAY=
# How many pictures all visitors together may weave a day. 0 closes weaving.
WEAVES_PER_DAY=
# How many pictures Dreamloom may register under its own name a day. 0 closes it.
REGISTRATIONS_PER_DAY=
# How many passports Dreamloom may move to visitors a day. 0 closes it.
MOVES_PER_DAY=
# How many co-signs Dreamloom may start a day. 0 closes it.
COSIGNS_PER_DAY=
