    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/fetch": "2.25.0",
    "dotenv": "17.4.2",
    "openai": "7.10.0",
    "sharp": "0.35.4",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
