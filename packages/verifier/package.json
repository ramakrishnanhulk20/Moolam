{
  "name": "@moolam/verifier",
  "private": true,
  "version": "0.1.0",
  "description": "Image fingerprinting, dihedral matching, C2PA soft bindings and the Moolam verify service.",
  "type": "module",
  "scripts": {
    "spike": "tsx scripts/spike.ts",
    "robustness": "tsx scripts/robustness.ts",
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "reputation:post": "tsx scripts/reputation-post.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "0.9.3",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "fastify": "5.12.3",
    "imghash": "1.1.4",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "sharp": "0.35.4",
    "sharp-phash": "2.2.0",
    "undici": "8.10.2",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
