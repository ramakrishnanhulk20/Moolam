# /etc/moolam/runner.env on the VM. Owned by root, mode 0600, read by the moolam service user.
# The operator fills in the five values marked PASTE. Nothing in this file is ever committed or logged.
#
#   sudo install -d -m 0755 /etc/moolam
#   sudo cp runner.env.example /etc/moolam/runner.env
#   sudo chmod 0600 /etc/moolam/runner.env
#   sudo nano /etc/moolam/runner.env

# --- read by the CRE CLI itself, through -e /etc/moolam/runner.env ---
# The wallet that pays for every report transaction. PASTE.
CRE_ETH_PRIVATE_KEY=
# The endpoint packages/workflow/project.yaml expands for the monad-mainnet target. PASTE.
MONAD_MAINNET_RPC_URL=

# --- read by the runner ---
VERIFY_SERVICE_URL=https://verifier-production-d76f.up.railway.app
# The same value set on Railway as RUNNER_TOKEN. PASTE.
RUNNER_TOKEN=

# The same value set on Railway as SEALED_LINK_TOKEN. The private re-check workflow reads it as its
# secret; without it the runner refuses every privately re-checkable passport by name. PASTE.
CRE_SEALED_LINK_TOKEN=
# The hosted index. Moves whenever Envio is redeployed. PASTE.
ENVIO_GRAPHQL_URL=
# A public endpoint is enough: the runner only reads balances and receipts.
MONAD_RPC_URL=https://rpc.monad.xyz
CRE_WALLET_ADDRESS=0xC79620AF233a4434b03f6B57239F8A9E71B3C178
CRE_WORKFLOW_DIR=/srv/moolam/packages/workflow/moolam-verifier
CRE_ENV_FILE=/etc/moolam/runner.env
RUNNER_STATE_PATH=/var/lib/moolam-recheck-runner/state.json

# --- optional, left commented. Unset, the runner uses the default written on each line. ---
# The folder of the private re-check workflow. Default: the moolam-sealed-verifier folder beside
# CRE_WORKFLOW_DIR. Set it only when that workflow is kept somewhere else.
# CRE_SEALED_WORKFLOW_DIR=/srv/moolam/packages/workflow/moolam-sealed-verifier
# The target in packages/workflow/project.yaml that the CLI runs against. Default: monad-mainnet.
# Set it only to point the runner at a different target.
# CRE_WORKFLOW_TARGET=monad-mainnet
# Where an ipfs:// metadata address is fetched from. Default: the gateway in the workflow's own
# config.json, so the runner reads what the workflow reads. Set it only when that gateway changes.
# PINATA_GATEWAY_URL=https://lavender-personal-grasshopper-978.mypinata.cloud/ipfs/
# The registry the runner reads registrations and attestation counts from. Default: the registry in
# the workflow's own config.json. Set it only after the registry is redeployed, and change the
# workflow config to match.
# MOOLAM_REGISTRY_ADDRESS=0xa19188801E5DC93CD925884d73e4DaFc2bcb80C0

# --- the caps. The defaults are in src/config.ts; these are written out so they can be read. ---
RUNNER_INTERVAL_SECONDS=120
RUNNER_MAX_PER_PASS=5
RUNNER_MAX_REPORTS_PER_DAY=40
RUNNER_MIN_MON=1.5
RUNNER_SETTLE_SECONDS=120
RUNNER_COOLDOWN_SECONDS=21600
# The first wait after a passing miss (a gateway, index or node that did not answer). Doubles with
# each miss in a row, up to the cooldown above.
RUNNER_RETRY_SECONDS=600
# Keep this at least two minutes under TimeoutStopSec in the systemd unit (720), so a stop lets the
# run in hand finish and hand its request back.
RUNNER_SIMULATE_TIMEOUT_SECONDS=600
RUNNER_FAILURES_BEFORE_BACKOFF=3
RUNNER_BACKOFF_MINUTES=30

# Clears a tripped circuit breaker at start. Add it for one restart after fixing what made the
# receiver refuse, then delete the line: while it is here every restart clears the breaker unseen.
# RUNNER_RESET_BREAKER=1

# Set to 1 to run the whole loop with --broadcast left off. The live queue is read and never
# claimed, requested or answered. Nothing is sent and nothing is spent.
RUNNER_DRY_RUN=1
