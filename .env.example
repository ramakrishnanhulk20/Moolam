# Moolam environment. Copy to .env and fill in. Never commit .env.

# Monad RPC endpoints. Mainnet is the build target; testnet is a fallback only.
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Optional, secret, and read on the server only: a dedicated Monad endpoint, such as a QuickNode
# one, whose address carries its own access token. The web app tries it before the public endpoint
# on every read it makes, so a rate-limited minute on either side is a slower page and not an
# error. Leave it empty and the public endpoint answers everything. It must be an https URL, and it
# must never be given a NEXT_PUBLIC name: that would publish the token to every browser. The same
# address belongs in MONAD_MAINNET_RPC_URL above if the scripts and the verify service should use
# it too.
MONAD_RPC_URL=

# Deployer wallet. Deploys the contracts and runs the seed and prove-it scripts.
# Needs MON on mainnet: 10 MON stays reserved by the chain, plus gas.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Chainlink CRE wallet. Signs the workflow's attestation transactions during
# `cre workflow simulate --broadcast`. Needs MON on mainnet like the deployer.
CRE_ETH_PRIVATE_KEY=
CRE_WALLET_ADDRESS=
# The workflow name in packages/workflow/moolam-verifier/workflow.yaml. The receiver is
# pinned to it, so the two must always match.
CRE_WORKFLOW_NAME=moolam-verifier

# Privy (dashboard.privy.io): app id, app secret, and the authorization key
# used to control server wallets from the backend.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=

# Envio (envio.dev/app/api-tokens): HyperSync and Envio Cloud token.
ENVIO_API_TOKEN=

# Alchemy (dashboard.alchemy.com): a Monad app key, and the webhook signing key
# once a webhook exists.
ALCHEMY_API_KEY=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# The generator agent's brain and image model. OpenAI is the default; OpenRouter is the fallback
# provider for text. Model names default to the cheapest current ones and can be pinned here.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AGENT_PROVIDER=openai
AGENT_TEXT_MODEL=
AGENT_IMAGE_MODEL=

# Pinata (app.pinata.cloud): IPFS uploads for images and C2PA manifests.
PINATA_JWT=

# x402: the address that receives verification payments in USDC.
X402_PAY_TO_ADDRESS=

# Where the verifier service runs.
VERIFIER_BASE_URL=http://localhost:4010
# Browser origins allowed to call the verifier directly (comma separated, exact origins). The studio uploads from the browser.
CORS_ORIGINS=http://localhost:3210

# Verifier service. The C2PA signing certificate and key are generated into a
# gitignored folder on first run; set these two to use a real certificate.
VERIFIER_PORT=4010
# Where the verifier's passport index comes from: json (a local file) or envio (the live indexer).
PASSPORT_SOURCE=envio
PASSPORT_SOURCE_PATH=packages/verifier/test-assets/passports.json
MOOLAM_C2PA_CERT_PATH=
MOOLAM_C2PA_KEY_PATH=
# Which proxy hops the verifier may believe for a caller's address (comma separated: addresses, CIDRs, or loopback, linklocal, uniquelocal). Empty means trust none and read the socket. On Railway set loopback,uniquelocal,100.64.0.0/10.
TRUST_PROXY=
# How often the verifier rebuilds its passport index from the source, in milliseconds. 0 turns the refresh off.
INDEX_REFRESH_MS=60000
# How long a verification waits for a free matching slot before the caller is told the service is busy, in milliseconds.
MATCH_WAIT_MS=30000
# Routes this host must be able to mount or it refuses to boot (comma separated: prepare, generate, edit, verify/paid). Empty means mount whatever the keys allow.
EXPECT_ROUTES=

# Contracts. A P-256 key used only by the live proof script to act as a passkey; the
# script generates it on first run. The Monadscan key is optional (second explorer).
PROOF_P256_PRIVATE_KEY=
MONADSCAN_API_KEY=

# Chainlink CRE. Either run `cre login` once (opens a browser) or paste an API key from the CRE dashboard.
CRE_API_KEY=

# Verifier on-chain signer: posts ERC-8004 reputation feedback about generator agents. Must not be an agent owner (the registry refuses self-feedback). Needs about 12 MON (10 stay reserved).
VERIFIER_PRIVATE_KEY=
VERIFIER_ADDRESS=
ENVIO_GRAPHQL_URL=
X402_ENABLED=false
# Paid verification route, only when X402_ENABLED=true. Price in USDC per call and the Monad facilitator.
X402_PRICE=$0.05
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
# The demo wallet that pays for `npm run pay:verify` in packages/agents. A few dollars of USDC on
# Monad mainnet is enough and it needs no MON: the facilitator pays the settlement gas itself.
X402_PAYER_PRIVATE_KEY=
# Where that client sends its paid verification. The live service, or http://localhost:4010 when
# the verifier is running on this machine.
X402_VERIFIER_URL=https://verifier-production-d76f.up.railway.app

# Pinata dedicated gateway for this account (per-account rate limits). Falls back to the public gateway when empty.
PINATA_GATEWAY_URL=

# The generate route on the verify service: the agent that draws pictures for signed-in creators.
# GENERATOR_WALLET_ID and GENERATOR_WALLET_ADDRESS are the Privy server wallet the agent scripts created
# (packages/agents/.moolam/wallets.json); GENERATOR_AGENT_ID is its ERC-8004 id; GENERATE_PER_DAY caps
# pictures per creator; MOOLAM_REGISTRY_ADDRESS is the registry the generator signature is bound to.
GENERATOR_WALLET_ID=
GENERATOR_WALLET_ADDRESS=
GENERATOR_AGENT_ID=10249
GENERATE_PER_DAY=3
MOOLAM_REGISTRY_ADDRESS=0xa19188801E5DC93CD925884d73e4DaFc2bcb80C0

# The consent register the verify service reads statements from, so an answer says what the
# picture's holder allows AI to do with it. Default is the deployed contract on Monad mainnet.
CONSENT_ADDRESS=0x1151E69a82947920546e779c4C8c785b2a3C1277

# The edit route on the verify service: a creator grants a signer on their own wallet and the
# service appends the edit for them. PRIVY_EDIT_SIGNER_ID is the key quorum whose one member is the
# public half of PRIVY_AUTHORIZATION_KEY; run `npm run edit:quorum` in packages/agents to create it
# once and write the id into your .env. PRIVY_EDIT_POLICY_ID is the policy that quorum is held to,
# built by sessionSignerPolicy in packages/agents/src/privy/policies.ts and recorded in
# packages/agents/.moolam/wallets.json: appendEdit on the Moolam registry, no MON, nothing else.
# EDITS_PER_DAY caps how many edits one creator may append in a rolling 24 hours.
PRIVY_EDIT_SIGNER_ID=
PRIVY_EDIT_POLICY_ID=
EDITS_PER_DAY=5
