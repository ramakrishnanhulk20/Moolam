# Moolam environment. Copy to .env and fill in. Never commit .env.

# Monad mainnet RPC endpoint, read by packages/contracts/foundry.toml and the scripts. Mainnet is the build target.
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
# The endpoint the verify service falls back to when MONAD_MAINNET_RPC_URL drops a read, tried
# second and never first. Leave it at Monad's public endpoint and put a dedicated one, whose address
# carries its own access token, in MONAD_MAINNET_RPC_URL above. Must be an https URL.
MONAD_RPC_FALLBACK_URL=https://rpc.monad.xyz

# Optional, secret, and read on the server only: a dedicated Monad endpoint, such as a QuickNode
# one, whose address carries its own access token. The web app tries it before the public endpoint
# on every read it makes, so a rate-limited minute on either side is a slower page and not an
# error. Leave it empty and the public endpoint answers everything. It must be an https URL, and it
# must never be given a NEXT_PUBLIC name: that would publish the token to every browser. The same
# address belongs in MONAD_MAINNET_RPC_URL above if the scripts and the verify service should use
# it too.
MONAD_RPC_URL=

# Deployer wallet. Deploys the contracts and runs the seed and prove-it scripts.
# Needs MON on mainnet: 10 MON stays reserved by the chain, plus gas.
DEPLOYER_PRIVATE_KEY=

# Chainlink CRE wallet. Signs the workflow's attestation transactions during
# `cre workflow simulate --broadcast`. Needs MON on mainnet like the deployer.
CRE_ETH_PRIVATE_KEY=
CRE_WALLET_ADDRESS=
# The workflow name in packages/workflow/moolam-verifier/workflow.yaml. The receiver is
# pinned to it, so the two must always match.
CRE_WORKFLOW_NAME=moolam-verifier
# Read by packages/recheck-runner, which loads its own env file (deploy/runner.env.example) and not
# this one. Set CRE_WORKFLOW_TARGET when the runner should use a CRE target other than
# monad-mainnet, and CRE_SEALED_WORKFLOW_DIR when the private re-check workflow is not the
# moolam-sealed-verifier folder beside CRE_WORKFLOW_DIR. Empty means those defaults.
CRE_WORKFLOW_TARGET=
CRE_SEALED_WORKFLOW_DIR=

# Privy (dashboard.privy.io): app id, app secret, and the authorization key
# used to control server wallets from the backend.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
# Local tests only: a JWKS file the verifier checks Privy tokens against instead of Privy's own keys.
# Set it only to run the verifier tests offline. The service refuses to start with it set when
# NODE_ENV is production.
# PRIVY_JWKS_OVERRIDE_PATH=

# Envio (envio.dev/app/api-tokens): HyperSync and Envio Cloud token. Read by the envio command
# itself, not by Moolam code: have it set when you run envio codegen, dev or start in packages/indexer.
ENVIO_API_TOKEN=

# The generator agent's brain and image model. OpenAI is the default; OpenRouter is the fallback
# provider for text. Model names default to the cheapest current ones and can be pinned here.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AGENT_PROVIDER=openai
AGENT_TEXT_MODEL=
AGENT_IMAGE_MODEL=
# Set when the image model sits behind another OpenAI-compatible host, such as a proxy. Empty means
# the provider's own address.
AGENT_IMAGE_BASE_URL=
# The same for the text model. Left commented because the agents package refuses an empty value here.
# AGENT_LLM_BASE_URL=
# Local only: the full path to the anvil binary the agents package forks Monad mainnet with. Set it
# when anvil is in neither ~/.foundry/bin nor on the PATH.
# ANVIL_PATH=

# Pinata (app.pinata.cloud): IPFS uploads for images and C2PA manifests.
PINATA_JWT=

# x402: the address that receives verification payments in USDC.
X402_PAY_TO_ADDRESS=

# Where the verifier service runs.
VERIFIER_BASE_URL=http://localhost:4010
# Browser origins allowed to call the verifier directly (comma separated, exact origins). The studio uploads from the browser.
CORS_ORIGINS=http://localhost:3210

# Verifier service. The C2PA signing certificate and key are generated into a
# gitignored folder on first run; set these two to use a real certificate.
VERIFIER_PORT=4010
# Where the verifier's passport index comes from: json (a local file) or envio (the live indexer).
PASSPORT_SOURCE=envio
PASSPORT_SOURCE_PATH=packages/verifier/test-assets/passports.json
MOOLAM_C2PA_CERT_PATH=
MOOLAM_C2PA_KEY_PATH=
# Which proxy hops the verifier may believe for a caller's address (comma separated: addresses, CIDRs, or loopback, linklocal, uniquelocal). Empty means trust none and read the socket. On Railway set loopback,uniquelocal,100.64.0.0/10.
TRUST_PROXY=
# How often the verifier rebuilds its passport index from the source, in milliseconds. 0 turns the refresh off.
INDEX_REFRESH_MS=60000
# How long a verification waits for a free matching slot before the caller is told the service is busy, in milliseconds.
MATCH_WAIT_MS=30000
# Routes this host must be able to mount or it refuses to boot (comma separated: prepare, generate, edit, verify/paid). Empty means mount whatever the keys allow.
EXPECT_ROUTES=
# What the whole world may spend in a UTC day, per action. Every other limit is per signed-in account and
# accounts are free, so these three are what bound a day of sponsored gas, Pinata pins and model spend.
# A ceiling of 0 closes that route for everyone, which is the kill switch to flip on the host without a deploy.
# The counts are saved in DATA_DIR/global-day.json, so on a volume a redeploy keeps them; the real bound on gas is the Privy app's daily cap.
GLOBAL_PREPARES_PER_DAY=300
GLOBAL_GENERATIONS_PER_DAY=60
GLOBAL_EDITS_PER_DAY=150
GLOBAL_UNSEALS_PER_DAY=50
# Read links /sealed/link may mint to private copies in a UTC day, across every passport: empty means 100, and 0 switches the route off.
GLOBAL_LINKS_PER_DAY=
# Platform kit prepares one platform key may make in a rolling 24 hours: empty means 100, and 0 closes /platform/prepare.
PLATFORM_PREPARES_PER_KEY_PER_DAY=
# Platform kit prepares every platform together may make in a UTC day: empty means 500, and 0 closes /platform/prepare.
GLOBAL_PLATFORM_PREPARES_PER_DAY=

# Contracts. A P-256 key used only by the live proof script to act as a passkey; the
# script generates it on first run. The Monadscan key is optional (second explorer).
PROOF_P256_PRIVATE_KEY=
MONADSCAN_API_KEY=
# One-shot arguments for the scripts in packages/contracts/script. Both are left commented: set them
# for the run that needs them and take them out after.
# The deployed MoolamReceiver that ConfigureReceiver.s.sol pins to CRE_WALLET_ADDRESS and
# CRE_WORKFLOW_NAME. The script fails without it.
# RECEIVER=
# The agent card URI RegisterAgent.s.sol stores for the demo agent. Unset, it stores the card built
# into the script.
# MOOLAM_AGENT_URI=

# Chainlink CRE. Either run `cre login` once (opens a browser) or paste an API key from the CRE dashboard.
CRE_API_KEY=

# Verifier on-chain signer: posts ERC-8004 reputation feedback about generator agents. Must not be an agent owner (the registry refuses self-feedback). Needs about 12 MON (10 stay reserved).
VERIFIER_PRIVATE_KEY=
VERIFIER_ADDRESS=
ENVIO_GRAPHQL_URL=
X402_ENABLED=false
# Paid verification route, only when X402_ENABLED=true. Price in USDC per call and the Monad facilitator.
X402_PRICE=$0.05
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
# The demo wallet that pays for `npm run pay:verify` in packages/agents. A few dollars of USDC on
# Monad mainnet is enough and it needs no MON: the facilitator pays the settlement gas itself.
X402_PAYER_PRIVATE_KEY=
# Where that client sends its paid verification. The live service, or http://localhost:4010 when
# the verifier is running on this machine.
X402_VERIFIER_URL=https://verifier-production-d76f.up.railway.app

# Pinata dedicated gateway for this account (per-account rate limits). Falls back to the public gateway when empty. The re-check runner reads the same name from its own env file.
PINATA_GATEWAY_URL=

# The generate route on the verify service: the agent that draws pictures for signed-in creators.
# GENERATOR_WALLET_ID and GENERATOR_WALLET_ADDRESS are the Privy server wallet the agent scripts created
# (packages/agents/.moolam/wallets.json); GENERATOR_AGENT_ID is its ERC-8004 id; GENERATE_PER_DAY caps
# pictures per creator; MOOLAM_REGISTRY_ADDRESS is the registry the generator signature is bound to
# (the re-check runner reads that name too, from its own env file).
GENERATOR_WALLET_ID=
GENERATOR_WALLET_ADDRESS=
GENERATOR_AGENT_ID=10249
GENERATE_PER_DAY=3
MOOLAM_REGISTRY_ADDRESS=0xa19188801E5DC93CD925884d73e4DaFc2bcb80C0

# The consent register the verify service reads statements from, so an answer says what the
# picture's holder allows AI to do with it. Default is the deployed contract on Monad mainnet.
CONSENT_ADDRESS=0x1151E69a82947920546e779c4C8c785b2a3C1277

# The edit route on the verify service: a creator grants a signer on their own wallet and the
# service appends the edit for them. PRIVY_EDIT_SIGNER_ID is the key quorum whose one member is the
# public half of PRIVY_AUTHORIZATION_KEY; run `npm run edit:quorum` in packages/agents to create it
# once and write the id into your .env. PRIVY_EDIT_POLICY_ID is the policy that quorum is held to,
# built by sessionSignerPolicy in packages/agents/src/privy/policies.ts and recorded in
# packages/agents/.moolam/wallets.json: appendEdit on the Moolam registry, no MON, nothing else.
# EDITS_PER_DAY caps how many edits one creator may append in a rolling 24 hours.
PRIVY_EDIT_SIGNER_ID=
PRIVY_EDIT_POLICY_ID=
EDITS_PER_DAY=5

# The re-check queue on the verify service: anyone may ask for a Chainlink second opinion on a
# picture, and the runner in packages/recheck-runner picks the requests up. RUNNER_TOKEN is the
# bearer token that runner sends, at least 24 characters, and the same value goes in the runner's
# own environment; leave it empty and the three runner routes answer 503 while the public request
# and status routes keep working.
RUNNER_TOKEN=
# The folder every state file lives in: the re-check queue, the daily ceilings, the quotas, the private
# copies' keep times and the sweep's place. Empty: the Railway volume's mount path when Railway sets
# one, else test-assets/state for local work. It must be an absolute path.
DATA_DIR=
# Set by Railway itself when a volume is attached, so leave it commented and set DATA_DIR only to
# override it. DATA_DIR wins when both are set.
# RAILWAY_VOLUME_MOUNT_PATH=
# Where the queue file is kept, so a restart does not lose what people asked for. Defaults to
# recheck-queue.json in DATA_DIR; set it only to keep the queue somewhere else.
RECHECK_QUEUE_PATH=
# The bearer token the private re-check workflow sends to POST /sealed/link, at least 24 characters.
# The same value goes in the runner's env file as CRE_SEALED_LINK_TOKEN. Empty: the route answers 503
# and no private copy can be read by anyone.
SEALED_LINK_TOKEN=
# The hourly sweep of private copies whose passport never registered: off, dry (the default, only logs what it would delete) or delete.
PRIVATE_SWEEP=
# Claim with your email, on the verify service. CLAIM_PEPPER is the secret every email is hashed
# with before it is stored: 32 random bytes as hex, made once with `openssl rand -hex 32`, never
# committed and never reused. CLAIM_PEPPER_VERSION starts at 1 and goes up by one with every new
# pepper; offers made under an older one expire. Leave both empty and the claim routes answer 503.
CLAIM_PEPPER=
CLAIM_PEPPER_VERSION=
# What GET /claims, accept and refuse may cost together in one UTC day for everyone. 0 closes them.
CLAIM_REQUESTS_PER_DAY=20000
# When Moolam's re-check workflow went live on Chainlink's network, in unix seconds. Verdicts from 0x0d69 before it are simulator verdicts. The head chef sets it after the network deploy; unset, the backlog lists only what it can judge.
NETWORK_ACTIVATION_TIME=
# The MoolamLookalikes receiver Chainlink writes look-alike records to: 0xC0f3984A8116dB8BE514F649e3605A2a3aCd454C on Monad mainnet.
LOOKALIKE_RECEIVER=
# A Google Cloud API key restricted to the Cloud Vision API, for the web check on public captured uploads. Server only, never printed. Unset, the web check is off.
GOOGLE_VISION_API_KEY=
# How many pictures the web check may send to Google Cloud Vision in one UTC day, for everyone. 0 switches the web check off.
VISION_CHECKS_PER_DAY=300
